<atlassian-plugin key="ir.arasstech.persian.jsm" name="Arass Tech Persian for Jira Service Management" plugins-version="2">

    <plugin-info>
        <description>Persian (فارسی) for Jira Service Management Data Center by Arass Tech: Persian locale with full translation of Jira and Jira Service Management, Vazirmatn typeface, right-to-left layout and Jalali (Shamsi) dates and date picker for Persian users. Free and open source (MIT license).</description>
        <version>1.2.0</version>
        <vendor name="Arass Tech" url="https://arasstech.ir"/>
        <param name="plugin-icon">images/plugin-icon.png</param>
        <param name="plugin-logo">images/plugin-logo.png</param>
        <param name="plugin-banner">images/plugin-banner.png</param>
        <param name="vendor-icon">images/vendor-icon.png</param>
        <param name="vendor-logo">images/vendor-logo.png</param>
        <param name="atlassian-data-center-status">compatible</param>
        <param name="atlassian-data-center-compatible">true</param>
        <param name="configure.url">/plugins/servlet/atp/admin</param>
    </plugin-info>

