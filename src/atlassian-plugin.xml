    <resource type="download" name="images/" location="images/"/>

    <!-- Typeface for everyone (Persian glyphs only); RTL layout only for Persian users -->
    <web-resource key="atp-ui" name="Arass Tech Persian UI layer">
        <resource type="download" name="atp-core.css" location="css/atp-core.css"/>
        <resource type="download" name="atp-rtl.css" location="css/atp-rtl.css"/>
        <resource type="download" name="atp-theme.css" location="css/atp-theme.css"/>
        <resource type="download" name="atp-mirror.js" location="js/atp-mirror.js"/>
        <resource type="download" name="atp-boot.js" location="js/atp-boot.js"/>
        <resource type="download" name="atp-dates.js" location="js/atp-dates.js"/>
        <dependency>com.atlassian.plugins.atlassian-plugins-webresource-plugin:data</dependency>
        <data key="settings" class="ir.arasstech.persian.SettingsDataProvider"/>
        <context>atl.general</context>
        <context>atl.admin</context>
        <context>atl.popup</context>
        <context>customerportal</context>
        <context>com.atlassian.streams:streamsGadgetResources</context>
    </web-resource>

    <!-- Settings page: Administration → Manage apps → Arass Tech Persian -->
    <web-resource key="atp-admin" name="Arass Tech Persian settings page">
        <resource type="download" name="atp-admin.css" location="admin/atp-admin.css"/>
        <resource type="download" name="atp-admin.js" location="admin/atp-admin.js"/>
    </web-resource>

    <!-- Every translated text with its English source; never required by a page, the settings page loads it on demand -->
    <web-resource key="atp-catalog" name="Arass Tech Persian translation catalog">
        <resource type="download" name="atp-catalog.js" location="admin/atp-catalog.js">
            <param name="batch" value="false"/>
        </resource>
    </web-resource>

    <servlet key="atp-servlet" name="Arass Tech Persian settings" class="ir.arasstech.persian.AtpServlet">
        <description>Settings page and its JSON API (Jira administrators only).</description>
        <url-pattern>/atp/*</url-pattern>
    </servlet>

    <web-item key="atp-admin-link" name="Arass Tech Persian settings link" section="admin_plugins_menu/upm_section" weight="150">
        <label key="atp.admin.menu"/>
        <tooltip key="atp.admin.menu.tooltip"/>
        <link linkId="atp-admin-link">/plugins/servlet/atp/admin</link>
    </web-item>

    <!-- The administrator's own wording replaces the bundled Persian text, everywhere Jira translates on the server -->
    <translation-transform key="atp-overrides" name="Arass Tech Persian custom wording" class="ir.arasstech.persian.OverrideTransform" order="100"/>

</atlassian-plugin>
